{
  // Cloudflare Workers configuration. The site itself is the static folder "out" (made by `npm run build`).
  // The only code that runs is worker/index.ts, and only for /api/*; every other address is answered
  // straight from the static files, with no code involved.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wingshub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
