# Copy to .env.local for local overrides. On Netlify, set these under
# Site configuration > Environment variables.

# Canonical origin used for canonical URLs, Open Graph, sitemap and structured data.
# Leave as the production domain, even for previews.
NEXT_PUBLIC_SITE_URL=https://wingshub.ca

# "draft" (default): noindex, robots.txt blocks crawlers, draft banner shown.
# "live": indexable. The build fails if any data file is still marked "draft".
NEXT_PUBLIC_CONTENT_STATUS=draft

# ---- Contact form (Cloudflare Pages Function: functions/api/contact.ts) ----
# These are set in Cloudflare Pages > Settings > Variables and secrets, not in this repository.
#
# Public, used when the site is built:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY   public key of the Cloudflare Turnstile check (optional)
#
# Used by the Function when a message arrives:
#   BREVO_API_KEY         SECRET. An API key from brevo.com (SMTP & API > API keys)
#   CONTACT_TO            who receives the messages (default info@wingshub.ca)
#   CONTACT_FROM_EMAIL    sender address, a verified sender in Brevo (default info@wingshub.ca)
#   CONTACT_FROM_NAME     sender name shown in the inbox (default "Wings Hub website")
#   ALLOWED_ORIGINS       addresses the form may be sent from (default https://wingshub.ca,https://www.wingshub.ca)
#   TURNSTILE_SECRET_KEY  SECRET. Secret key of the Turnstile check (optional; set together with the site key)
